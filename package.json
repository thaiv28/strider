{
  "name": "backpack-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backpacking trip planner and gear/weight tracker",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:up": "docker run -d --name backpack-db -e POSTGRES_USER=backpack -e POSTGRES_PASSWORD=backpack -e POSTGRES_DB=backpack -p 5433:5432 -v backpack-pgdata:/var/lib/postgresql/data postgres:16",
    "db:down": "docker rm -f backpack-db",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:backup": "bash scripts/backup-db.sh",
    "db:restore": "bash scripts/restore-db.sh",
    "import": "tsx scripts/import-sheets.ts",
    "test:mobile": "playwright test tests/mobile.spec.ts",
    "test:workflow": "playwright test tests/workflows.spec.ts --project=workflow",
    "test:e2e": "playwright test",
    "verify": "tsx scripts/verify.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@types/leaflet": "^1.9.22",
    "@types/pngjs": "^6.0.5",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.36.4",
    "jpeg-js": "^0.4.4",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.38.0",
    "marked": "^18.0.11",
    "next": "^15.5.24",
    "next-auth": "^5.0.0-beta.32",
    "node-ical": "^0.27.1",
    "pg": "^8.13.1",
    "pngjs": "^7.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "cheerio": "^1.0.0",
    "drizzle-kit": "^0.28.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
