events {}

http {
  server {
    listen 80;
    client_max_body_size 12m;

    if ($http_x_origin_verify != "__ORIGIN_SECRET__") {
      return 403;
    }

    location / {
      proxy_http_version 1.1;
      proxy_set_header Host backpack.thaiv.dev;
      proxy_set_header X-Forwarded-Host backpack.thaiv.dev;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection "upgrade";
      proxy_pass http://backpack-app:3000;
    }
  }
}
